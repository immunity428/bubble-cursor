{
  "manifest_version": 3,
  "name": "Bubble Cursor",
  "version": "0.1.0",
  "description": "カーソルの当たり判定を一番近いリンクやボタンまで広げて、クリックしやすくします（Grossman & Balakrishnan, CHI 2005）",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bubble Cursor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-bubble": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Bubble Cursor のオン/オフを切り替える"
    }
  }
}
